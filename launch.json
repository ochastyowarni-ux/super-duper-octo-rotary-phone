{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "1. Ingest & Index Catalog (Build FAISS)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/ingest_and_index.py",
            "console": "integratedTerminal",
            "justMyCode": true
        },
        {
            "name": "2. Run Streamlit Academic Advisor App",
            "type": "debugpy",
            "request": "launch",
            "module": "streamlit",
            "args": [
                "run",
                "${workspaceFolder}/app.py",
                "--server.port=8501"
            ],
            "console": "integratedTerminal",
            "justMyCode": true
        }
    ]
}
